# Binaries
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go
vendor/
go.work
go.work.sum
coverage.*

# Certificates and keys (generated by `aigatekeeper ca init`)
certs/*
!certs/.gitkeep

# Runtime data (SQLite audit store)
data/*
!data/.gitkeep

# Web UI build output and dependencies
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/.vite/
web/coverage/

# Local config overrides / secrets
*.local.yaml
.env
.env.*

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# local build/test scratch
.gotmp/

# Local Docker test fixtures
.gotmp/
